<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TaynDM.Controls">

    <Style TargetType="{x:Type local:SpeedChart}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SpeedChart}">
                    <Border Background="Transparent" BorderThickness="0">
                        <Canvas x:Name="PART_Canvas" ClipToBounds="True">
                            <Polygon x:Name="PART_Fill" Fill="#1A0A84FF" />
                            <Polyline x:Name="PART_Line" Stroke="#0A84FF" StrokeThickness="1.5" />
                        </Canvas>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
