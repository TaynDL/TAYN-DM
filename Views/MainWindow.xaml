<Window x:Class="TaynDM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaynDM.Controls"
        Title="TAYN DM"
        Width="1240" Height="790"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBg}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        SizeChanged="MainWindow_SizeChanged">

  <!-- ═══════════════════════════════════════════════════════════════
       WINDOW RESOURCES
       ═══════════════════════════════════════════════════════════════ -->
  <Window.Resources>

    <!-- ── Theme Colors ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="CardBg"             Color="#151D29"/>
    <SolidColorBrush x:Key="CardBorder"         Color="#243248"/>
    <SolidColorBrush x:Key="CardHover"          Color="#172334"/>
    <SolidColorBrush x:Key="CardHoverBorder"    Color="#146FC4"/>
    <SolidColorBrush x:Key="CardSelected"       Color="#15243A"/>
    <SolidColorBrush x:Key="CardSelectedBorder" Color="#0A84FF"/>

    <SolidColorBrush x:Key="TitleBarBg"         Color="#0B101C"/>
    <SolidColorBrush x:Key="TitleBarBorder"     Color="#20283A"/>
    <SolidColorBrush x:Key="TitleText"          Color="#D9E0EC"/>

    <SolidColorBrush x:Key="SidebarLabel"       Color="#415269"/>
    <SolidColorBrush x:Key="SidebarSeparator"   Color="#202C3E"/>

    <SolidColorBrush x:Key="FilterActiveBg"     Color="#0D4A89"/>
    <SolidColorBrush x:Key="FilterActiveBorder" Color="#0A84FF"/>

    <SolidColorBrush x:Key="LanguageBg"         Color="#102944"/>
    <SolidColorBrush x:Key="LanguageBorder"     Color="#145C95"/>
    <SolidColorBrush x:Key="LanguageFg"         Color="#51B9FF"/>

    <SolidColorBrush x:Key="StatusCardBg"       Color="#101728"/>
    <SolidColorBrush x:Key="StatusCardBorder"   Color="#232C42"/>
    <SolidColorBrush x:Key="StatusLabel"        Color="#56637A"/>
    <SolidColorBrush x:Key="StatusText"         Color="#C3CCDA"/>

    <SolidColorBrush x:Key="GlyphBg"            Color="#243247"/>
    <SolidColorBrush x:Key="GlyphFg"            Color="#AEBBCB"/>
    <SolidColorBrush x:Key="ProgressTrackBg"    Color="#27354A"/>

    <SolidColorBrush x:Key="SpeedTextFg"        Color="#708198"/>
    <SolidColorBrush x:Key="SpeedSepFg"         Color="#445268"/>
    <SolidColorBrush x:Key="PercentFg"          Color="#1E9BFF"/>
    <SolidColorBrush x:Key="SizeTextFg"         Color="#78879D"/>

    <SolidColorBrush x:Key="ActiveCardBg"       Color="#173642"/>
    <SolidColorBrush x:Key="TotalCardBg"        Color="#292846"/>
    <SolidColorBrush x:Key="TotalCardFg"        Color="#A99CFF"/>

    <SolidColorBrush x:Key="SearchIconFg"       Color="#60718A"/>
    <SolidColorBrush x:Key="FooterFg"           Color="#657188"/>

    <SolidColorBrush x:Key="DetailsBg"          Color="#0D141F"/>
    <SolidColorBrush x:Key="DetailsBorder"      Color="#223047"/>
    <SolidColorBrush x:Key="DetailsLabel"       Color="#6D7B91"/>
    <SolidColorBrush x:Key="DetailsGlyphBg"     Color="#202D40"/>
    <SolidColorBrush x:Key="DetailsGlyphFg"     Color="#B9C4D3"/>
    <SolidColorBrush x:Key="DetailsSize"        Color="#75849A"/>
    <SolidColorBrush x:Key="DetailsKey"         Color="#647289"/>
    <SolidColorBrush x:Key="DetailsStatus"      Color="#159CFF"/>
    <SolidColorBrush x:Key="DetailsValue"       Color="#D3DBE8"/>
    <SolidColorBrush x:Key="DetailsUrl"         Color="#2588D6"/>

    <SolidColorBrush x:Key="NoSelBg"            Color="#17243A"/>
    <SolidColorBrush x:Key="NoSelBorder"        Color="#27415F"/>
    <SolidColorBrush x:Key="NoSelIcon"          Color="#39ADFF"/>
    <SolidColorBrush x:Key="NoSelTitle"         Color="#E3EAF4"/>
    <SolidColorBrush x:Key="NoSelHint"          Color="#687991"/>

    <SolidColorBrush x:Key="SpeedChartBg"       Color="#0D1321"/>
    <SolidColorBrush x:Key="SpeedChartFg"       Color="#4E5A70"/>

    <!-- DataGrid styles -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background"             Value="{StaticResource TitleBarBg}"/>
      <Setter Property="Foreground"             Value="{StaticResource SpeedTextFg}"/>
      <Setter Property="FontSize"               Value="11"/>
      <Setter Property="FontWeight"             Value="SemiBold"/>
      <Setter Property="Height"                 Value="48"/>
      <Setter Property="BorderBrush"            Value="{StaticResource TitleBarBorder}"/>
      <Setter Property="BorderThickness"        Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Height"                 Value="70"/>
      <Setter Property="Background"             Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush"            Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness"        Value="0,0,0,1"/>
      <Setter Property="Foreground"             Value="{StaticResource Ink}"/>
      <Setter Property="FontSize"               Value="12"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource CardHover}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource CardSelected}"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness"        Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding"                Value="10,0"/>
      <Setter Property="FocusVisualStyle"       Value="{x:Null}"/>
    </Style>

    <!-- Animated ProgressBar style -->
    <Style x:Key="AnimatedProgressBar" TargetType="ProgressBar">
      <Setter Property="Background"             Value="{StaticResource ProgressTrackBg}"/>
      <Setter Property="Foreground"             Value="{StaticResource Aurora}"/>
      <Setter Property="BorderThickness"        Value="0"/>
      <Setter Property="Height"                 Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="3"
                      RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="ScaleX" ScaleX="0" ScaleY="1"/>
                </Border.RenderTransform>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Empty state pulse storyboard -->
    <Storyboard x:Key="EmptyPulse" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="EmptyIcon"
                       Storyboard.TargetProperty="Opacity"
                       From="0.4" To="1.0" Duration="0:0:1.5"
                       AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

  </Window.Resources>

  <!-- ═══════════════════════════════════════════════════════════════
       ROOT BORDER
       ═══════════════════════════════════════════════════════════════ -->
  <Border BorderBrush="{StaticResource CardBorder}"
          BorderThickness="1"
          Background="{StaticResource AppBg}">

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition/>
      </Grid.RowDefinitions>

      <!-- ── TITLE BAR ──────────────────────────────────────────── -->
      <Border Background="{StaticResource TitleBarBg}"
              BorderBrush="{StaticResource TitleBarBorder}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <!-- App identity (left) -->
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="18,0"
                      FlowDirection="LeftToRight">
            <Border Width="24" Height="24" CornerRadius="7"
                    Background="{StaticResource Aurora}">
              <TextBlock Text="T" Foreground="White" FontSize="13"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="TAYN DM" Foreground="{StaticResource TitleText}"
                       FontWeight="Bold" FontSize="11"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <!-- Window controls (right) -->
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Left"
                      FlowDirection="LeftToRight"
                      Margin="8,0">
            <Button Style="{StaticResource IconButton}" Content="&#x2014;"
                    Click="Minimize_Click" ToolTip="Minimize"/>
            <Button Style="{StaticResource IconButton}" Content="&#x25A1;"
                    Click="Maximize_Click" ToolTip="Maximize"/>
            <Button Style="{StaticResource IconButton}" Content="&#x2715;"
                    Foreground="{StaticResource Danger}"
                    Click="Close_Click" ToolTip="Close"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══════════════════════════════════════════════════════════
           MAIN SHELL (3-column layout)
           ═══════════════════════════════════════════════════════════ -->
      <Grid x:Name="MainShell" Grid.Row="1" FlowDirection="LeftToRight">

        <!-- VisualStateManager for responsive collapse -->
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="WindowWidthStates">
            <VisualState x:Name="WideState"/>
            <VisualState x:Name="NarrowState">
              <Storyboard>
                <ObjectAnimationUsingKeyFrames
                    Storyboard.TargetName="DetailsPanel"
                    Storyboard.TargetProperty="Visibility">
                  <DiscreteObjectKeyFrame KeyTime="0"
                      Value="Collapsed"/>
                </ObjectAnimationUsingKeyFrames>
              </Storyboard>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="224"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════════
             SIDEBAR
             ════════════════════════════════════════════════════════ -->
        <Border x:Name="SidebarPanel"
                Background="{StaticResource Sidebar}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,1,0"
                FlowDirection="RightToLeft"
                Width="224">

          <Grid Margin="20,22,20,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="20"/>
              <RowDefinition/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo + Title -->
            <StackPanel>
              <Border Width="76" Height="76" CornerRadius="38"
                      BorderBrush="{StaticResource Primary}"
                      BorderThickness="1"
                      HorizontalAlignment="Right"
                      Effect="{StaticResource SoftShadow}"
                      ClipToBounds="True">
                <Image Source="assets/tayn-logo.png" Stretch="UniformToFill"/>
              </Border>
              <TextBlock Text="TAYN DM" Foreground="White" FontSize="22"
                         FontWeight="Bold" Margin="0,13,0,3"
                         FlowDirection="LeftToRight"
                         HorizontalAlignment="Right"/>
              <TextBlock Text="DOWNLOAD MANAGER"
                         Foreground="{StaticResource Primary}"
                         FontSize="9"
                         FlowDirection="LeftToRight"
                         HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- ── DOWNLOADS filters ─────────────────────────────── -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="DOWNLOADS"
                           Foreground="{StaticResource SidebarLabel}"
                           FontSize="9"
                           FlowDirection="LeftToRight"
                           HorizontalAlignment="Right"
                           Margin="0,0,4,7"/>

                <!-- All downloads (active filter) -->
                <Border Background="{StaticResource FilterActiveBg}"
                        BorderBrush="{StaticResource FilterActiveBorder}"
                        BorderThickness="1"
                        CornerRadius="9" Padding="11,9">
                  <TextBlock Text="&#x25A3;   &#x0647;&#x0645;&#x0647; &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F;&#x0647;&#x0627;"
                             Foreground="White" FontWeight="SemiBold"/>
                </Border>

                <!-- In download -->
                <Button Content="&#x2193;   &#x062F;&#x0631; &#x062D;&#x0627;&#x0644; &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F;"
                        Style="{StaticResource GhostButton}"
                        HorizontalContentAlignment="Right"
                        Margin="0,3"
                        ToolTip="In progress downloads"/>

                <!-- Paused -->
                <Button Content="&#x23F8;   &#x0645;&#x062A;&#x0648;&#x0642;&#x0641;&#x200C;&#x0634;&#x062F;&#x0647;"
                        Style="{StaticResource GhostButton}"
                        HorizontalContentAlignment="Right"
                        Margin="0,3"
                        ToolTip="Paused downloads"/>

                <!-- Completed -->
                <Button Content="&#x2713;   &#x062A;&#x06A9;&#x0645;&#x06CC;&#x0644;&#x200C;&#x0634;&#x062F;&#x0647;"
                        Style="{StaticResource GhostButton}"
                        HorizontalContentAlignment="Right"
                        Margin="0,3"
                        ToolTip="Completed downloads"/>

                <!-- Errors -->
                <Button Content="&#x26A0;   &#x062E;&#x0637;&#x0627;&#x0647;&#x0627;"
                        Style="{StaticResource GhostButton}"
                        HorizontalContentAlignment="Right"
                        Margin="0,3"
                        ToolTip="Failed downloads"/>
              </StackPanel>
            </ScrollViewer>

            <!-- ── Bottom: Settings + Language + Status ─────────── -->
            <StackPanel Grid.Row="3">
              <Border Height="1" Background="{StaticResource SidebarSeparator}"
                      Margin="3,10"/>

              <!-- Settings -->
              <Button Content="&#x2699;   &#x062A;&#x0646;&#x0638;&#x06CC;&#x0645;&#x0627;&#x062A;"
                      Style="{StaticResource GhostButton}"
                      HorizontalContentAlignment="Right"
                      Margin="0,2"
                      Click="Settings_Click"
                      ToolTip="Application settings"/>

              <!-- Language toggle -->
              <Button x:Name="LanguageButton"
                      Content="EN"
                      Click="Language_Click"
                      Background="{StaticResource LanguageBg}"
                      BorderBrush="{StaticResource LanguageBorder}"
                      Foreground="{StaticResource LanguageFg}"
                      Margin="0,9,0,9"
                      ToolTip="Toggle language (EN/FA)"/>

              <!-- System status card -->
              <Border Background="{StaticResource StatusCardBg}"
                      BorderBrush="{StaticResource StatusCardBorder}"
                      BorderThickness="1"
                      CornerRadius="13" Padding="14">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="SYSTEM STATUS"
                               Foreground="{StaticResource StatusLabel}"
                               FontSize="9"
                               FlowDirection="LeftToRight"
                               HorizontalAlignment="Right"/>
                    <Ellipse Width="8" Height="8"
                             Fill="{StaticResource Success}"
                             HorizontalAlignment="Left"/>
                  </Grid>
                  <TextBlock Text="&#x0622;&#x0645;&#x0627;&#x062F;&#x0647; &#x0628;&#x0631;&#x0627;&#x06CC; &#x062F;&#x0631;&#x06CC;&#x0627;&#x0641;&#x062A;"
                             Foreground="{StaticResource StatusText}"
                             FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>

          </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             CENTER PANEL
             ════════════════════════════════════════════════════════ -->
        <Grid x:Name="CenterPanel"
              Grid.Column="1"
              Margin="24,27,24,20"
              FlowDirection="RightToLeft">

          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="88"/>
            <RowDefinition Height="18"/>
            <RowDefinition/>
            <RowDefinition Height="36"/>
          </Grid.RowDefinitions>

          <!-- ── Header: Title + Add button ──────────────────────── -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="&#x0645;&#x0631;&#x06A9;&#x0632; &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F;"
                         Foreground="{StaticResource Ink}"
                         FontSize="27" FontWeight="Bold"/>
              <TextBlock Text="&#x0641;&#x0627;&#x06CC;&#x0644;&#x200C;&#x0647;&#x0627;&#x06CC;&#x062A; &#x0631;&#x0627; &#x0633;&#x0631;&#x06CC;&#x0639;&#x060C; &#x0627;&#x06CC;&#x0645;&#x0646; &#x0648; &#x0628;&#x062F;&#x0648;&#x0646; &#x0648;&#x0642;&#x0641;&#x0647; &#x062F;&#x0631;&#x06CC;&#x0627;&#x0641;&#x062A; &#x06A9;&#x0646;"
                         Foreground="{StaticResource Muted}"
                         FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="+   &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F; &#x062C;&#x062F;&#x06CC;&#x062F;"
                    Style="{StaticResource PrimaryButton}"
                    Click="Add_Click"
                    VerticalAlignment="Center"
                    MinWidth="164"
                    ToolTip="Add new download (Ctrl+V)"/>
          </Grid>

          <!-- ── Stats cards row ─────────────────────────────────── -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <!-- Active downloads card -->
            <Border Grid.Column="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="13"
                    Margin="0,0,7,0" Padding="16"
                    ToolTip="Number of active downloads">
              <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="&#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F; &#x0641;&#x0639;&#x0627;&#x0644;"
                             Foreground="{StaticResource Muted}" FontSize="11"/>
                  <TextBlock Text="{Binding ActiveCountText}"
                             Foreground="White" FontSize="23"
                             FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="38" Height="38"
                        CornerRadius="11"
                        Background="{StaticResource ActiveCardBg}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                  <TextBlock Text="&#x21E3;"
                             Foreground="{StaticResource Success}"
                             FontSize="23"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>

            <!-- Total files card -->
            <Border Grid.Column="1"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="13"
                    Margin="7,0" Padding="16"
                    ToolTip="Total number of files">
              <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="&#x06A9;&#x0644; &#x0641;&#x0627;&#x06CC;&#x0644;&#x200C;&#x0647;&#x0627;"
                             Foreground="{StaticResource Muted}" FontSize="11"/>
                  <TextBlock Text="{Binding TotalCountText}"
                             Foreground="White" FontSize="23"
                             FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="38" Height="38"
                        CornerRadius="11"
                        Background="{StaticResource TotalCardBg}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                  <TextBlock Text="&#x25A4;"
                             Foreground="{StaticResource TotalCardFg}"
                             FontSize="18"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>

            <!-- Search + filter card -->
            <Border Grid.Column="2"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="13"
                    Margin="7,0,0,0" Padding="12">
              <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="125"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <Grid>
                  <TextBox x:Name="SearchBox"
                           Height="42"
                           Padding="34,0,10,0"
                           TextChanged="Search_Changed"
                           ToolTip="Search downloads by name..."/>
                  <TextBlock Text="&#x2315;"
                             Foreground="{StaticResource SearchIconFg}"
                             FontSize="19" Margin="11,0,0,2"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"/>
                  <TextBlock x:Name="SearchHint"
                             Text="&#x062C;&#x0633;&#x062A;&#x200C;&#x0648;&#x062C;&#x0648;..."
                             Foreground="{StaticResource SearchIconFg}"
                             Margin="35,0,8,0"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>

                <!-- Filter combo -->
                <ComboBox x:Name="FilterBox"
                          Grid.Column="1"
                          Height="42"
                          Margin="8,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="Search_Changed"
                          ToolTip="Filter downloads by status">
                  <ComboBoxItem Content="&#x0647;&#x0645;&#x0647;" Tag="all"/>
                  <ComboBoxItem Content="&#x0641;&#x0639;&#x0627;&#x0644;" Tag="active"/>
                  <ComboBoxItem Content="&#x062A;&#x06A9;&#x0645;&#x06CC;&#x0644;&#x200C;&#x0634;&#x062F;&#x0647;" Tag="done"/>
                </ComboBox>
              </Grid>
            </Border>
          </Grid>

          <!-- ── Downloads list panel ────────────────────────────── -->
          <Border Grid.Row="4"
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="15"
                  Effect="{StaticResource SoftShadow}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition/>
              </Grid.RowDefinitions>

              <!-- Toolbar -->
              <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal">
                  <Button Content="&#x25B6;  &#x0634;&#x0631;&#x0648;&#x0639;"
                          Padding="12,8"
                          Click="Start_Click"
                          ToolTip="&#x0634;&#x0631;&#x0648;&#x0639; / &#x0627;&#x062F;&#x0627;&#x0645;&#x0647; &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F;"/>
                  <Button Content="&#x23F8;  &#x062A;&#x0648;&#x0642;&#x0641;"
                          Padding="12,8"
                          Click="Pause_Click"
                          ToolTip="&#x062A;&#x0648;&#x0642;&#x0641; &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F;"/>
                  <Button Content="&#x25A3;  &#x067E;&#x0648;&#x0634;&#x0647;"
                          Padding="12,8"
                          Click="OpenFolder_Click"
                          ToolTip="&#x0628;&#x0627;&#x0632; &#x06A9;&#x0631;&#x062F;&#x0646; &#x067E;&#x0648;&#x0634;&#x0647;"/>
                  <Button Content="&#x2715;"
                          Padding="12,8"
                          Foreground="{StaticResource Danger}"
                          Click="Remove_Click"
                          ToolTip="&#x062D;&#x0630;&#x0641; &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F;"/>
                </StackPanel>
              </Grid>

              <!-- Download items + empty state -->
              <Grid Grid.Row="1">
                <ListBox x:Name="DownloadsGrid"
                         ItemsSource="{Binding Downloads}"
                         SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="10,4">

                  <!-- Context menu -->
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="&#x0634;&#x0631;&#x0648;&#x0639; / &#x0627;&#x062F;&#x0627;&#x0645;&#x0647;"
                                Click="Start_Click"/>
                      <MenuItem Header="&#x062A;&#x0648;&#x0642;&#x0641;"
                                Click="Pause_Click"/>
                      <Separator/>
                      <MenuItem Header="&#x0627;&#x0648;&#x0644;&#x0648;&#x06CC;&#x062A; &#x0628;&#x06CC;&#x0634;&#x062A;&#x0631;"
                                Click="PriorityUp_Click"/>
                      <MenuItem Header="&#x0627;&#x0648;&#x0644;&#x0648;&#x06CC;&#x062A; &#x06A9;&#x0645;&#x062A;&#x0631;"
                                Click="PriorityDown_Click"/>
                      <Separator/>
                      <MenuItem Header="&#x0628;&#x0627;&#x0632; &#x06A9;&#x0631;&#x062F;&#x0646; &#x067E;&#x0648;&#x0634;&#x0647;"
                                Click="OpenFolder_Click"/>
                      <MenuItem Header="&#x062D;&#x0630;&#x0641;"
                                Click="Remove_Click"/>
                    </ContextMenu>
                  </ListBox.ContextMenu>

                  <!-- Item container style (card look) -->
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0,4"/>
                      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card"
                                    Background="{StaticResource CardBg}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="11" Padding="14">
                              <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{StaticResource CardHoverBorder}"/>
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{StaticResource CardHover}"/>
                              </Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{StaticResource CardSelectedBorder}"/>
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{StaticResource CardSelected}"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>

                  <!-- Item template -->
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="82" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="58"/>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>

                        <!-- File icon -->
                        <Border Grid.Column="0"
                                Width="46" Height="54"
                                CornerRadius="10"
                                Background="{StaticResource GlyphBg}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding FileGlyph}"
                                     Foreground="{StaticResource GlyphFg}"
                                     FontSize="22"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>

                        <!-- File info + progress -->
                        <Grid Grid.Column="1" Margin="12,5,18,5">
                          <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="18"/>
                          </Grid.RowDefinitions>

                          <TextBlock Text="{Binding FileName}"
                                     Foreground="White" FontSize="13"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>

                          <ProgressBar Grid.Row="1"
                                       Style="{StaticResource AnimatedProgressBar}"
                                       Value="{Binding Percent, Mode=OneWay}"
                                       Height="6"
                                       VerticalAlignment="Center"/>

                          <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding SpeedText}"
                                       Foreground="{StaticResource SpeedTextFg}"
                                       FontSize="10"/>
                            <TextBlock Text="  /  "
                                       Foreground="{StaticResource SpeedSepFg}"/>
                            <TextBlock Text="{Binding EtaText}"
                                       Foreground="{StaticResource SpeedTextFg}"
                                       FontSize="10"/>
                          </StackPanel>
                        </Grid>

                        <!-- Status / percent / size -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                          <TextBlock Text="{Binding PercentText}"
                                     Foreground="{StaticResource PercentFg}"
                                     FontSize="20" FontWeight="Bold"
                                     HorizontalAlignment="Right"/>
                          <TextBlock Text="{Binding SizeText}"
                                     Foreground="{StaticResource SizeTextFg}"
                                     FontSize="9"
                                     HorizontalAlignment="Right"
                                     Margin="0,4,0,0"/>
                          <TextBlock Text="{Binding StatusDisplay}"
                                     Foreground="{StaticResource Success}"
                                     FontSize="9"
                                     HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>

                </ListBox>

                <!-- ── Empty state (pulsing animation) ─────────── -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=DownloadsGrid}"
                                     Value="False">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>

                  <Border x:Name="EmptyIcon"
                          Width="72" Height="72"
                          CornerRadius="36"
                          BorderBrush="{StaticResource Primary}"
                          BorderThickness="2"
                          Opacity="0.7">
                    <TextBlock Text="&#x21E3;"
                               FontSize="38"
                               Foreground="{StaticResource Aurora}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>

                  <TextBlock Text="&#x0635;&#x0641; &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F; &#x062E;&#x0627;&#x0644;&#x06CC; &#x0627;&#x0633;&#x062A;"
                             Foreground="{StaticResource NoSelTitle}"
                             FontSize="15" FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             Margin="0,16,0,5"/>
                  <TextBlock Text="&#x0627;&#x0648;&#x0644;&#x06CC;&#x0646; &#x0641;&#x0627;&#x06CC;&#x0644; &#x062E;&#x0648;&#x062F; &#x0631;&#x0627; &#x0627;&#x0636;&#x0627;&#x0641;&#x0647; &#x06A9;&#x0646;"
                             Foreground="{StaticResource NoSelHint}"
                             FontSize="11"
                             HorizontalAlignment="Center"/>

                  <!-- Trigger the pulse animation on load -->
                  <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard Storyboard="{StaticResource EmptyPulse}"/>
                    </EventTrigger>
                  </StackPanel.Triggers>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <!-- ── Footer ──────────────────────────────────────────── -->
          <Grid Grid.Row="5">
            <TextBlock Text="{Binding FooterText}"
                       Foreground="{StaticResource FooterFg}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
          </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════
             DETAILS PANEL (right side)
             ════════════════════════════════════════════════════════ -->
        <Border x:Name="DetailsPanel"
                Grid.Column="2"
                Width="292"
                Background="{StaticResource DetailsBg}"
                BorderBrush="{StaticResource DetailsBorder}"
                BorderThickness="1"
                CornerRadius="13"
                Margin="0,27,24,20"
                Padding="20"
                FlowDirection="LeftToRight">

          <Grid>
            <!-- ── When a download is selected ───────────────────── -->
            <Grid Visibility="{Binding HasSelection}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Section title -->
              <TextBlock Text="DOWNLOAD DETAILS"
                         Foreground="{StaticResource DetailsLabel}"
                         FontSize="9"/>

              <!-- Divider -->
              <Border Grid.Row="1"
                      Background="{StaticResource CardBorder}"
                      Margin="0,16"/>

              <!-- File icon + name + size -->
              <StackPanel Grid.Row="2">
                <Border Width="58" Height="66" CornerRadius="10"
                        Background="{StaticResource DetailsGlyphBg}"
                        HorizontalAlignment="Left">
                  <TextBlock Text="{Binding SelectedDownload.FileGlyph}"
                             Foreground="{StaticResource DetailsGlyphFg}"
                             FontSize="27"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding SelectedDownload.FileName, TargetNullValue=No file selected}"
                           Foreground="White" FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,13,0,4"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedDownload.SizeText}"
                           Foreground="{StaticResource DetailsSize}"
                           FontSize="11"/>
              </StackPanel>

              <!-- Detail rows -->
              <Grid Grid.Row="3" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="92"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status -->
                <TextBlock Text="Status"
                           Foreground="{StaticResource DetailsKey}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedDownload.StatusDisplay}"
                           Foreground="{StaticResource DetailsStatus}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Speed -->
                <TextBlock Grid.Row="1" Text="Speed"
                           Foreground="{StaticResource DetailsKey}"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding SelectedDownload.SpeedText}"
                           Foreground="{StaticResource DetailsValue}"/>

                <!-- Remaining -->
                <TextBlock Grid.Row="2" Text="Remaining"
                           Foreground="{StaticResource DetailsKey}"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding SelectedDownload.EtaText}"
                           Foreground="{StaticResource DetailsValue}"/>

                <!-- Downloaded -->
                <TextBlock Grid.Row="3" Text="Downloaded"
                           Foreground="{StaticResource DetailsKey}"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding SelectedDownload.SizeText}"
                           Foreground="{StaticResource DetailsValue}"/>

                <!-- SHA-256 -->
                <TextBlock Grid.Row="4" Text="SHA-256"
                           Foreground="{StaticResource DetailsKey}"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding SelectedDownload.Sha256}"
                           Foreground="{StaticResource DetailsValue}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- URL -->
                <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                           Text="{Binding SelectedDownload.Url}"
                           Foreground="{StaticResource DetailsUrl}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           MaxHeight="55"/>
              </Grid>

              <!-- ── Speed History Chart ────────────────────────── -->
              <Border Grid.Row="4"
                      Background="{StaticResource SpeedChartBg}"
                      CornerRadius="8"
                      Margin="0,12,0,0"
                      Padding="4">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="SPEED HISTORY"
                             Foreground="{StaticResource SpeedChartFg}"
                             FontSize="9"
                             Margin="8,6"/>
                  <local:SpeedChart Grid.Row="1"
                                   SpeedHistory="{Binding SpeedHistory}"
                                   MinHeight="60"/>
                </Grid>
              </Border>
            </Grid>

            <!-- ── When no download is selected ─────────────────── -->
            <StackPanel Visibility="{Binding HasNoSelection}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <Border Width="72" Height="72"
                      CornerRadius="36"
                      Background="{StaticResource NoSelBg}"
                      BorderBrush="{StaticResource NoSelBorder}"
                      BorderThickness="1">
                <TextBlock Text="&#x21E3;"
                           Foreground="{StaticResource NoSelIcon}"
                           FontSize="34"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="NoSelectionTitle"
                         Text="&#x06CC;&#x06A9; &#x062F;&#x0627;&#x0646;&#x0644;&#x0648;&#x062F; &#x0631;&#x0627; &#x0627;&#x0646;&#x062A;&#x062E;&#x0627;&#x0628; &#x06A9;&#x0646;&#x06CC;&#x062F;"
                         Foreground="{StaticResource NoSelTitle}"
                         FontSize="14" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Margin="0,18,0,6"/>
              <TextBlock x:Name="NoSelectionHint"
                         Text="&#x062C;&#x0632;&#x0626;&#x06CC;&#x0627;&#x062A; &#x0641;&#x0627;&#x06CC;&#x0644; &#x0627;&#x06CC;&#x0646;&#x062C;&#x0627; &#x0646;&#x0645;&#x0627;&#x06CC;&#x0634; &#x062F;&#x0627;&#x062F;&#x0647; &#x0645;&#x06CC;&#x200C;&#x0634;&#x0648;&#x062F;"
                         Foreground="{StaticResource NoSelHint}"
                         FontSize="10"
                         HorizontalAlignment="Center"/>
            </StackPanel>

          </Grid>
        </Border>

      </Grid>
    </Grid>
  </Border>
</Window>
