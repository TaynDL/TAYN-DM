    <SolidColorBrush x:Key="CheckFg"         Color="{StaticResource CheckFgColor}"/>

    <!-- ── ComboBoxItem (standalone) ────────────────────────────────────── -->
    <Color x:Key="ComboItemStandaloneFgColor">#DCE4F0</Color>
    <Color x:Key="ComboItemStandaloneBgColor">#131C2A</Color>

    <SolidColorBrush x:Key="ComboItemStandaloneFg" Color="{StaticResource ComboItemStandaloneFgColor}"/>
    <SolidColorBrush x:Key="ComboItemStandaloneBg" Color="{StaticResource ComboItemStandaloneBgColor}"/>

    <!-- ── Gradient accents ─────────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="Aurora" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#00C6FF" Offset="0"/>
      <GradientStop Color="#0A84FF" Offset="0.55"/>
      <GradientStop Color="#0057D9" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AuroraLight" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#007AFF" Offset="0"/>
      <GradientStop Color="#5856D6" Offset="0.55"/>
      <GradientStop Color="#AF52DE" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Effects ──────────────────────────────────────────────────────── -->
    <DropShadowEffect x:Key="SoftShadow"
                      BlurRadius="28"
                      ShadowDepth="6"
                      Opacity="0.28"
                      Color="#000000"/>


