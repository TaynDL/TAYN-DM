    <SolidColorBrush x:Key="BtnHoverBg"      Color="{StaticResource BtnHoverBgColor}"/>
    <SolidColorBrush x:Key="BtnHoverBorder"  Color="{StaticResource BtnHoverBorderColor}"/>

    <!-- ── CheckBox ─────────────────────────────────────────────────────── -->
