    <!-- ═══════════════════════════════════════════════════════════════════════
         CONTROL STYLES
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Default Button ──────────────────────────────────────────────── -->
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#CBD3E2"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background"
                        Value="{StaticResource BtnHoverBg}"/>
                <Setter TargetName="B" Property="BorderBrush"
                        Value="{StaticResource BtnHoverBorder}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="1.025" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Scale"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="1.025" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="1" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Scale"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#18223A"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#0A6CD4"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="0.97" Duration="0:0:0.08"/>
                      <DoubleAnimation Storyboard.TargetName="Scale"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="0.97" Duration="0:0:0.08"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="1" Duration="0:0:0.08"/>
                      <DoubleAnimation Storyboard.TargetName="Scale"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="1" Duration="0:0:0.08"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Primary (gradient) Button ───────────────────────────────────── -->
    <Style x:Key="PrimaryButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Aurora}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="19,12"/>
      <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
    </Style>

    <!-- ── Ghost (transparent) Button ──────────────────────────────────── -->
    <Style x:Key="GhostButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ── Icon Button (square) ────────────────────────────────────────── -->
    <Style x:Key="IconButton" TargetType="Button"
           BasedOn="{StaticResource GhostButton}">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- ── TextBox ─────────────────────────────────────────────────────── -->
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource TextBoxBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBoxCaret}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush"
                        Value="{StaticResource TextBoxFocusBorder}"/>
                <Setter TargetName="B" Property="Background"
                        Value="{StaticResource TextBoxFocusBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── ComboBoxItem ────────────────────────────────────────────────── -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground"
              Value="{StaticResource ComboItemStandaloneFg}"/>
      <Setter Property="Background"
              Value="{StaticResource ComboItemStandaloneBg}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- ── ComboBox ────────────────────────────────────────────────────── -->
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource TextBoxBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Outer"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                <Grid>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                    Margin="12,0,30,0"
                                    VerticalAlignment="Center"/>
                  <TextBlock Text="&#x25BC;"
                             Foreground="{StaticResource ComboArrow}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="12,0"/>
                </Grid>
              </Border>
              <ToggleButton Background="Transparent"
                            BorderThickness="0"
                            Opacity="0"
                            IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent},
                                          Mode=TwoWay}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False">
                <Border Background="{StaticResource ComboItemBg}"
                        BorderBrush="{StaticResource ComboPopupBorder}"
                        BorderThickness="1"
                        CornerRadius="9"
                        MinWidth="{TemplateBinding ActualWidth}"
                        Margin="0,4,0,0">
                  <ScrollViewer MaxHeight="260">
                    <StackPanel IsItemsHost="True"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Outer" Property="BorderBrush"
                        Value="{StaticResource ComboFocusBorder}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── CheckBox ────────────────────────────────────────────────────── -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource CheckFg}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════════════════
         ANIMATED PROGRESS BAR
         Custom ProgressBar with diagonal stripe animation.
         Use:  ProgressBar Style="{StaticResource AnimatedProgressBar}"
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="AnimatedProgressBar" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Aurora}"/>
      <Setter Property="Background" Value="{StaticResource ProgressBg}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <ControlTemplate.Resources>
              <!-- Fill-animation storyboard (seeked by the control to Value/Maximum) -->
              <Storyboard x:Key="ProgressFillStory">
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="FillElement"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                  <LinearDoubleKeyFrame KeyTime="0:0:0"    Value="0"/>
                  <LinearDoubleKeyFrame KeyTime="0:0:0.5"  Value="0.5"/>
                  <LinearDoubleKeyFrame KeyTime="0:0:1"    Value="1"/>
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>
              <!-- Stripe crawl animation (continuous while visible) -->
              <Storyboard x:Key="StripeCrawlStory" RepeatBehavior="Forever">
                <DoubleAnimation
                    Storyboard.TargetName="StripeTranslate"
                    Storyboard.TargetProperty="X"
                    From="0" To="28"
                    Duration="0:0:0.9">
                  <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </ControlTemplate.Resources>

            <Grid>
              <!-- Track background -->
              <Border x:Name="Background"
                      Background="{TemplateBinding Background}"
                      CornerRadius="4"/>
              <!-- Track sizing element -->
              <Border x:Name="PART_Track" Background="Transparent"/>
              <!-- Fill element (left-aligned, scale-driven progress) -->
              <Border x:Name="FillElement"
                      HorizontalAlignment="Left"
                      CornerRadius="4"
                      ClipToBounds="True"
                      RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="FillScale" ScaleX="0"/>
                  </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                  <!-- Solid gradient fill -->
                  <Border Background="{TemplateBinding Foreground}"/>
                  <!-- Diagonal stripe overlay -->
                  <Border x:Name="StripeOverlay" Opacity="0.22">
                    <Border.RenderTransform>
                      <TranslateTransform x:Name="StripeTranslate" X="0"/>
                    </Border.RenderTransform>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0"
                                           EndPoint="1,1"
                                           SpreadMethod="Tile"
                                           Viewport="0,0,0.14,0.14"
                                           ViewportUnits="RelativeToBoundingBox">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="0.38"/>
                        <GradientStop Color="#FFFFFF"      Offset="0.50"/>
                        <GradientStop Color="Transparent" Offset="0.62"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                </Grid>
              </Border>
            </Grid>

            <ControlTemplate.Triggers>
              <!-- Animate fill on value change -->
              <EventTrigger RoutedEvent="ValueChanged">
                <BeginStoryboard Storyboard="{StaticResource ProgressFillStory}"/>
              </EventTrigger>
              <!-- Start stripe crawl when loaded -->
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource StripeCrawlStory}"
                                 x:Name="StripeAnim"/>
              </EventTrigger>
              <!-- Hide fill at 100% (optional: show completed state) -->
              <Trigger Property="Value" Value="0">
                <Setter TargetName="FillElement" Property="Visibility"
                        Value="Hidden"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
