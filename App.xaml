    <Color x:Key="SectionLabelColor">  #415269</Color>
    <Color x:Key="SubtitleColor">      #3F8BCB</Color>

    <SolidColorBrush x:Key="SidebarBorder" Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="SidebarSep"    Color="{StaticResource SidebarSepColor}"/>
    <SolidColorBrush x:Key="SectionLabel"  Color="{StaticResource SectionLabelColor}"/>
    <SolidColorBrush x:Key="Subtitle"      Color="{StaticResource SubtitleColor}"/>

    <!-- ── Language button ──────────────────────────────────────────────── -->
    <Color x:Key="LangBtnBgColor">       #102944</Color>
