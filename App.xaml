    <Color x:Key="LangBtnTextColor">     #51B9FF</Color>

    <SolidColorBrush x:Key="LangBtnBg"      Color="{StaticResource LangBtnBgColor}"/>
    <SolidColorBrush x:Key="LangBtnBorder"  Color="{StaticResource LangBtnBorderColor}"/>
